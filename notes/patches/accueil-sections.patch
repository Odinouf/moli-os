+<script>
+  import { home, value, num, isOn, reachable, device, powerKey } from '../lib/home.svelte.js';
+  import { t } from '../../lib/i18n.svelte.js';
+  import Icon from './Icon.svelte';
+
+  const out = $derived(home.config?.outdoor ?? {});
+  const pool = $derived(out.pool);
+  const temp = $derived(pool ? value(pool, 'temperature') : null);
+  const look = $derived(pool ? value(pool, 'action_required') : null);
+  const pumpId = $derived(out.pool_pump ?? null);
+  const pumpKnown = $derived(!!(pumpId && reachable(pumpId) && powerKey(device(pumpId))));
+</script>
+
+<a class="card pool" href="#/dehors" aria-label={t('maison.accueil.piscine_ouvrir')}>
+  <div class="card-head">
+    <h2><Icon name="pool" size={18} />{t('maison.accueil.piscine')}</h2>
+    {#if look === true}<span class="chip cool">{t('maison.dehors.coup_oeil')}</span>{:else if look === false}<span class="chip good">{t('maison.dehors.tout_va_bien')}</span>{/if}
+  </div>
+  <div class="facts">
+    <div><small>{t('maison.dehors.eau')}</small><b class="num">{temp != null ? `${num(temp, 1)}°` : '—'}</b></div>
+    <div>
+      <small>{t('maison.accueil.piscine_pompe')}</small>
+      <b>{pumpKnown ? (isOn(pumpId) ? t('maison.accueil.piscine_marche') : t('maison.accueil.piscine_arret')) : '—'}</b>
+    </div>
+  </div>
+</a>
+
+<style>
+  .pool {
+    display: block;
+    color: inherit;
+    text-decoration: none;
+    transition: transform 0.2s var(--ease);
+  }
+
+  .pool:hover {
+    transform: translateY(-2px);
+  }
+
+  .card-head h2 {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    font-size: 16px;
+    font-weight: 700;
+  }
+
+  .facts {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 8px;
+    margin-top: 14px;
+  }
+
+  .facts small {
+    display: block;
+    font-size: 11px;
+    color: var(--ink-3);
+    font-weight: 650;
+  }
+
+  .facts b {
+    font-size: 17px;
+    font-weight: 650;
+  }
+</style>
