diff --git a/web/src/maison/ui/PlanPreview.svelte b/web/src/maison/ui/PlanPreview.svelte
new file mode 100644
index 0000000..5ca448c
--- /dev/null
+++ b/web/src/maison/ui/PlanPreview.svelte
@@ -0,0 +1,65 @@
+<script>
+  import { onMount } from 'svelte';
+  import { t } from '../../lib/i18n.svelte.js';
+  import Icon from './Icon.svelte';
+
+  let image = $state(null);
+
+  onMount(async () => {
+    try {
+      const res = await fetch('/api/plan');
+      if (!res.ok) return;
+      const plan = await res.json();
+      image = (plan.floors ?? []).find((f) => f.image)?.image ?? null;
+    } catch {
+      /* the card shows its empty state */
+    }
+  });
+</script>
+
+<a class="card plan" href="#/plan" aria-label={t('maison.accueil.plan_ouvrir')}>
+  <div class="card-head">
+    <h2><Icon name="home-roof" size={18} />{t('maison.accueil.plan')}</h2>
+    <span class="more" aria-hidden="true"><Icon name="arrow-top-right" size={18} /></span>
+  </div>
+  {#if image}
+    <div class="shot"><img src="/api/plan/images/{image}" alt="" loading="lazy" /></div>
+  {:else}
+    <p class="muted">{t('maison.accueil.plan_vide')}</p>
+  {/if}
+</a>
+
+<style>
+  .plan {
+    display: block;
+    color: inherit;
+    text-decoration: none;
+    transition: transform 0.2s var(--ease);
+  }
+
+  .plan:hover {
+    transform: translateY(-2px);
+  }
+
+  .card-head h2 {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    font-size: 16px;
+    font-weight: 700;
+  }
+
+  .shot {
+    margin-top: 12px;
+    border-radius: var(--r-md);
+    background: var(--surface-2);
+    overflow: hidden;
+  }
+
+  .shot img {
+    display: block;
+    width: 100%;
+    max-height: 240px;
+    object-fit: contain;
+  }
+</style>
diff --git a/web/src/maison/ui/PoolCard.svelte b/web/src/maison/ui/PoolCard.svelte
