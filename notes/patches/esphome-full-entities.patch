+        (api::EntityKind::Switch, Value::Bool(on)) => {
+            (api::SWITCH_COMMAND, api::switch_command(key, *on))
+        }
+        (api::EntityKind::Light, Value::Bool(on)) => {
+            (api::LIGHT_COMMAND, api::light_command(key, *on))
+        }
