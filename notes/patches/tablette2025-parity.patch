diff --git a/web/src/maison/ui/BinsCard.svelte b/web/src/maison/ui/BinsCard.svelte
new file mode 100644
index 0000000..80ba4ad
--- /dev/null
+++ b/web/src/maison/ui/BinsCard.svelte
@@ -0,0 +1,148 @@
+<script>
+  // Les poubelles : la prochaine sortie de chaque bac, sans calendrier.
+  // Chaque bac a une date d'ancrage et une récurrence de 14 jours (une
+  // semaine sur deux), lues dans la configuration de la maison. Jours
+  // restants calculés depuis la date du jour, à l'heure de la maison.
+  import { home } from '../lib/home.svelte.js';
+  import { t } from '../../lib/i18n.svelte.js';
+  import Icon from './Icon.svelte';
+
+  // { jaune: { anchor: '2026-10-28' }, noire: { anchor: '2026-10-21' } }
+  const bins = $derived(home.config?.bins ?? null);
+
+  const DAY = 86_400_000;
+
+  /** Prochain ramassage à partir de l'ancre, par pas de 14 jours. */
+  function nextOn(anchor, nowMs) {
+    if (!anchor) return null;
+    const t0 = Date.parse(`${anchor}T00:00:00`);
+    if (!Number.isFinite(t0)) return null;
+    if (t0 >= nowMs) return t0;
+    const period = 14 * DAY;
+    const steps = Math.ceil((nowMs - t0) / period);
+    return t0 + steps * period;
+  }
+
+  const rows = $derived.by(() => {
+    if (!bins) return [];
+    const midnight = new Date(home.now);
+    midnight.setHours(0, 0, 0, 0);
+    const nowMs = midnight.getTime();
+    return [
+      { key: 'jaune', icon: 'recycle', tone: 'yellow', label: t('maison.accueil.poubelle_jaune'), at: nextOn(bins.jaune?.anchor, nowMs) },
+      { key: 'noire', icon: 'trash-outline', tone: 'black', label: t('maison.accueil.poubelle_noire'), at: nextOn(bins.noire?.anchor, nowMs) },
+    ]
+      .filter((r) => r.at != null)
+      .map((r) => ({ ...r, days: Math.round((r.at - nowMs) / DAY) }))
+      .sort((a, b) => a.days - b.days);
+  });
+
+  function when(days) {
+    if (days <= 0) return t('maison.accueil.poubelle_aujourdhui');
+    if (days === 1) return t('maison.accueil.poubelle_demain');
+    return t('maison.accueil.poubelle_dans', { n: days });
+  }
+
+  function dayLabel(ms) {
+    return new Date(ms).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'short' });
+  }
+</script>
+
+{#if rows.length}
+  <section class="card bins" aria-label={t('maison.accueil.poubelles')}>
+    <div class="card-head">
+      <h2><Icon name="trash" size={16} />{t('maison.accueil.poubelles')}</h2>
+    </div>
+    <div class="rows">
+      {#each rows as r (r.key)}
+        <div class="row" class:soon={r.days <= 1}>
+          <span class="dot {r.tone}"><Icon name={r.icon} size={15} /></span>
+          <span class="words">
+            <b>{r.label}</b>
+            <small class="muted">{dayLabel(r.at)}</small>
+          </span>
+          <span class="when {r.days <= 1 ? 'hot' : ''}">{when(r.days)}</span>
+        </div>
+      {/each}
+    </div>
+  </section>
+{/if}
+
+<style>
+  .bins {
+    display: grid;
+    gap: 12px;
+  }
+
+  .card-head h2 {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    font-size: 16px;
+    font-weight: 700;
+  }
+
+  .rows {
+    display: grid;
+    gap: 8px;
+  }
+
+  .row {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    padding: 8px 10px;
+    border-radius: 12px;
+    background: var(--surface-2);
+  }
+
+  .row.soon {
+    background: var(--warm-soft);
+  }
+
+  .dot {
+    flex: none;
+    display: grid;
+    place-items: center;
+    width: 30px;
+    height: 30px;
+    border-radius: 9px;
+    background: var(--surface);
+    color: var(--ink-2);
+  }
+
+  .dot.yellow {
+    color: #b48a00;
+  }
+
+  .dot.black {
+    color: var(--ink-3);
+  }
+
+  .words {
+    display: grid;
+    gap: 1px;
+    min-width: 0;
+    flex: 1;
+  }
+
+  .words b {
+    font-size: 14px;
+    font-weight: 650;
+  }
+
+  .words small {
+    font-size: 12px;
+  }
+
+  .when {
+    flex: none;
+    font-size: 13px;
+    font-weight: 700;
+    color: var(--ink-3);
+  }
+
+  .when.hot {
+    color: var(--warm-ink);
+  }
+</style>
