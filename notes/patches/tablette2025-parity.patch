+<script>
+  import { home, hub, device, value, isOn, toggle, nameOf, doorOpen, pending } from '../lib/home.svelte.js';
+  import { t } from '../../lib/i18n.svelte.js';
+  import Icon from './Icon.svelte';
+
+  const CONTACT = ['contact', 'doorcontact_state'];
+  const hasContact = (d) => d.points.some((p) => CONTACT.includes(p.key));
+
+  const doors = $derived.by(() => {
+    const hidden = home.config?.hidden ?? [];
+    const listed = home.config?.doors ?? [];
+    const known = new Set(listed.map((d) => d.id));
+    const others = Object.values(hub.devices)
+      .filter((d) => !known.has(d.id) && !hidden.includes(d.id) && hasContact(d))
+      .map((d) => ({ id: d.id, name: nameOf(d.id) }));
+    return [...listed, ...others];
+  });
+  const openCount = $derived(doors.filter((d) => doorOpen(d.id) === true).length);
+  const silentCount = $derived(doors.filter((d) => device(d.id)?.online === false).length);
+  const doorTone = $derived(openCount ? 'warm' : silentCount ? 'cool' : 'good');
+
+  const meter = $derived.by(() => {
+    for (const id of home.config?.badges?.meters ?? []) if (device(id)) return id;
+    return Object.values(hub.devices).find((d) => /tore/i.test(nameOf(d.id)))?.id ?? null;
+  });
+  const watts = $derived(meter ? value(meter, 'power') : null);
+  const wattsShown = $derived(watts != null ? Math.round(Math.abs(Number(watts))) : null);
+
+  // Tempo (EDF): the day's colour and tomorrow's, beside the live power.
+  const COLOURS = ['bleu', 'blanc', 'rouge'];
+  const known = (c) => COLOURS.includes(c);
+  const tempoId = $derived(home.config?.outdoor?.tempo ?? null);
+  const tempoDay = $derived(tempoId ? value(tempoId, 'today') : null);
+  const tempoNext = $derived(tempoId ? value(tempoId, 'tomorrow') : null);
+  // A day whose colour is unknown says nothing: the badge hides outright.
+  const tempoKnown = $derived(known(tempoDay));
+  const tempoName = (c) => t(`maison.tempo.${known(c) ? c : 'inconnu'}`);
+
+  const switches = $derived(home.config?.badges?.switches ?? []);
+</script>
+
+<nav class="badges" aria-label={t('maison.accueil.badges')}>
+  <a class="badge {doorTone}" href="#/pieces">
+    <Icon name={openCount ? 'door-open' : 'door-closed'} size={16} />
+    {#if openCount}
+      {t('maison.accueil.badges_portes', { count: openCount })}
+    {:else if silentCount}
+      {t('maison.accueil.badges_portes_muettes')}
+    {:else}
+      {t('maison.accueil.badges_portes_fermees')}
+    {/if}
+  </a>
+
+  {#if meter}
+    <a class="badge cool" href="#/energie">
+      <Icon name="bolt" size={16} />
+      {t('maison.accueil.badges_conso', { value: wattsShown != null ? `${wattsShown} W` : '—' })}
+    </a>
+  {/if}
+
+  {#if tempoKnown}
+    <a class="badge tempo" href="#/energie" title={t('maison.accueil.badges_tempo')} aria-label={`${t('maison.accueil.badges_tempo')} : ${t('maison.accueil.badges_tempo_jour')} ${tempoName(tempoDay)}${known(tempoNext) ? `, ${t('maison.accueil.badges_tempo_demain')} ${tempoName(tempoNext)}` : ''}`}>
+      <i class="dot {tempoDay}" aria-hidden="true"></i>
+      <span class="tl">{t('maison.accueil.badges_tempo_jour')}</span>{tempoName(tempoDay)}
+      {#if known(tempoNext)}
+        <i class="dot {tempoNext}" aria-hidden="true"></i>
+        <span class="tl">{t('maison.accueil.badges_tempo_demain')}</span>{tempoName(tempoNext)}
+      {/if}
+    </a>
+  {/if}
+
+  {#each switches as s (s.id)}
+    <button class="badge" class:on={isOn(s.id)} class:busy={pending(s.id)} aria-pressed={isOn(s.id)} onclick={() => toggle(s.id, s.name)}>
+      <Icon name={s.icon ?? 'power'} size={16} />{s.name}
+    </button>
+  {/each}
+</nav>
+
+<style>
+  .badges {
+    display: flex;
+    gap: 8px;
+    overflow-x: auto;
+    scrollbar-width: none;
+    min-width: 0;
+    padding-bottom: 2px;
+  }
+
+  .badge {
+    flex: none;
+    display: inline-flex;
+    align-items: center;
+    gap: 7px;
+    border: 0;
+    border-radius: 999px;
+    padding: 8px 14px;
+    font: inherit;
+    font-size: 14px;
+    font-weight: 650;
+    background: var(--surface-2);
+    color: var(--ink-3);
+    text-decoration: none;
+    cursor: pointer;
+    transition: background 0.2s var(--ease), color 0.2s var(--ease);
+  }
+
+  .badge.good {
+    background: var(--good-soft);
+    color: var(--good);
+  }
+
+  .badge.warm {
+    background: var(--warm-soft);
+    color: var(--warm-ink);
+  }
+
+  .badge.cool {
+    background: var(--cool-soft, color-mix(in srgb, var(--cool) 16%, var(--surface-2)));
+    color: var(--cool);
+  }
+
+  .badge.on {
+    background: var(--warm);
+    color: #fff;
+  }
+
+  .badge.busy {
+    opacity: 0.55;
+    cursor: progress;
+  }
+
+  .badge.tempo {
+    gap: 6px;
+    color: var(--ink-2);
+  }
+
+  .badge.tempo .tl {
+    color: var(--ink-3);
+    font-weight: 600;
+  }
+
+  .badge.tempo .dot {
+    width: 10px;
+    height: 10px;
+    border-radius: 50%;
+    background: var(--ink-3);
+    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 12%);
+  }
+
+  .badge.tempo .dot + .tl {
+    margin-left: 2px;
+  }
+
+  .badge.tempo .dot.bleu {
+    background: #4b74f2;
+  }
+
+  .badge.tempo .dot.rouge {
+    background: #df5a40;
+  }
+
+  .badge.tempo .dot.blanc {
+    background: #eef1f6;
+  }
+
+  .badge.tempo .dot.inconnu {
+    background: transparent;
+    box-shadow: inset 0 0 0 1px var(--ink-3);
+  }
+</style>
