+    min-width: 150px;
+    padding: 10px 12px;
+    border-radius: 16px;
+    background: var(--surface-2);
+    color: inherit;
+    text-decoration: none;
+  }
+
+  .room-ico {
+    flex: none;
+    display: grid;
+    place-items: center;
+    width: 34px;
+    height: 34px;
+    border-radius: 11px;
+    background: var(--surface);
+    color: var(--ink-3);
+  }
+
+  .words {
+    display: grid;
+    gap: 2px;
+    min-width: 0;
+  }
+
+  .words b {
+    font-size: 14px;
+    font-weight: 700;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .readings {
+    display: inline-flex;
+    align-items: baseline;
+    gap: 8px;
