+<script>
+  // Une rangée de la tablette : un nom, l'appareil qui la commande, et ses
+  // lectures en pastilles (température, humidité, vitesse, consommation).
+  // C'est l'équivalent Moli des « bubble card » de la tablette Home
+  // Assistant : 56 px de haut, tout tient sur une ligne, un tap commande.
+  import { device, isOn, pending, reachable, toggle, value, nameOf } from '../lib/home.svelte.js';
+  import { t } from '../../lib/i18n.svelte.js';
+  import Icon from './Icon.svelte';
+
+  /** `subs` : pastilles de lecture, `{ icon, text, tone }`. `level` : la
+   *  grandeur montrée en pourcentage quand la commande est allumée. */
+  let { id, name = null, icon = 'light', subs = [], level = null, toggles = true } = $props();
+
+  const d = $derived(device(id));
+  const ok = $derived(reachable(id));
+  const on = $derived(ok && isOn(id));
+  const busy = $derived(pending(id));
+  const label = $derived(nameOf(id, name));
+  const pct = $derived(level ? value(id, level) : null);
+
+  function tap() {
+    if (!toggles || !ok) return;
+    toggle(id, label);
+  }
+</script>
+
+<div class="row" class:on class:off={!ok}>
+  {#if toggles}
+    <button class="main" aria-pressed={on} disabled={busy || !ok} onclick={tap} title={label}>
+      <span class="ico"><Icon name={icon} size={18} /></span>
+      <span class="name">{label}</span>
+      {#if pct != null && on}<span class="lvl num">{Math.round(Number(pct))} %</span>{/if}
+    </button>
+  {:else}
+    <span class="main static" title={label}>
+      <span class="ico"><Icon name={icon} size={18} /></span>
+      <span class="name">{label}</span>
+      {#if pct != null}<span class="lvl num">{Math.round(Number(pct))} %</span>{/if}
+    </span>
+  {/if}
+
+  <span class="subs">
+    {#each subs as s (s.icon + s.text)}
+      <span class="sub {s.tone ?? ''}" title={s.title ?? s.text}><Icon name={s.icon} size={13} />{s.text}</span>
+    {/each}
+  </span>
+</div>
+
+<style>
+  .row {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    height: 56px;
+    padding: 0 14px 0 10px;
+    border-radius: var(--r-md);
+    background: var(--surface);
+    box-shadow: var(--shadow);
+    min-width: 0;
+  }
+
+  .main {
+    display: inline-flex;
+    align-items: center;
+    gap: 10px;
+    min-width: 0;
+    flex: 1 1 auto;
+    border: 0;
+    border-radius: 12px;
+    padding: 4px 6px;
+    background: none;
+    color: inherit;
+    font: inherit;
+    cursor: pointer;
+    text-align: left;
+  }
+
+  .main.static {
+    cursor: default;
+  }
+
+  .main:disabled {
+    cursor: default;
+  }
+
+  @media (hover: hover) {
+    .main:not(.static):not(:disabled):hover {
+      background: var(--surface-2);
+    }
+
+    .row.off:hover .main {
+      background: none;
+    }
+  }
+
+  .ico {
+    flex: none;
+    display: grid;
+    place-items: center;
+    width: 32px;
+    height: 32px;
+    border-radius: 999px;
+    background: var(--surface-2);
+    color: var(--ink-3);
+    transition: background 0.2s var(--ease), color 0.2s var(--ease);
+  }
+
+  .on .ico {
+    background: var(--warm-soft);
+    color: var(--warm-ink);
+  }
+
+  .off .ico {
+    opacity: 0.55;
+  }
+
+  .off .name {
+    color: var(--ink-3);
+  }
+
+  .name {
+    font-size: 14px;
+    font-weight: 700;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .lvl {
+    font-size: 12px;
+    font-weight: 700;
+    color: var(--ink-3);
+  }
+
+  .subs {
+    display: flex;
+    align-items: center;
+    justify-content: end;
+    gap: 6px;
+    min-width: 0;
+    overflow: hidden;
+  }
+
+  .sub {
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    padding: 3px 8px;
+    border-radius: 999px;
+    background: var(--surface-2);
+    color: var(--ink-3);
+    font-size: 12px;
+    font-weight: 650;
+    white-space: nowrap;
+  }
+
+  .sub.warm {
+    background: var(--warm-soft);
+    color: var(--warm-ink);
+  }
+
+  .sub.cool {
+    background: var(--cool-soft);
+    color: var(--cool);
+  }
+
+  .sub.good {
+    background: var(--good-soft);
+    color: var(--good);
+  }
+</style>
diff --git a/web/src/maison/ui/TabletteRows.svelte b/web/src/maison/ui/TabletteRows.svelte
new file mode 100644
--- /dev/null
+++ b/web/src/maison/ui/TabletteRows.svelte
@@ -0,0 +1,149 @@
+<script>
+  // La pile de rangées de la tablette (colonne de gauche) : une rangée par
+  // appareil commandé depuis l'Accueil, avec ses lectures en pastilles —
+  // l'équivalent Moli des « bubble card » de Home Assistant.
+  //
+  // La liste vient de `data/home.json` (`tablette.rows`) : c'est la maison
+  // qui nomme ses appareils, pas le code. Une entrée porte un `room` (on
+  // prend le premier appareil de la pièce), ou un `match` (expression
+  // régulière sur le nom), ou un `id` explicite ; `kind` filtre le genre,
+  // `pair` met deux rangées côte à côte, `toggles: false` rend la rangée
+  // en lecture seule, `level` affiche un pourcentage, `power` ajoute la
+  // consommation d'une pince du Linky.
+  import { home, hub, value, device, nameOf, roomOf, deviceKind, tempIgnored } from '../lib/home.svelte.js';
+  import { t } from '../../lib/i18n.svelte.js';
+  import TabletteRow from './TabletteRow.svelte';
+
+  const norm = (s) =>
+    String(s ?? '')
+      .normalize('NFD')
+      .replace(/\p{M}/gu, '')
+      .toLowerCase();
+
+  const devices = $derived(Object.values(hub.devices));
+
+  const byId = (id) => devices.find((d) => d.id === id) ?? null;
+
+  /** Le premier appareil de la pièce qui passe `test` (kind facultatif). */
+  function pick(room, test, kind = null) {
+    const inRoom = devices.filter((d) => norm(roomOf(d)) === norm(room));
+    const pool = kind ? inRoom.filter((d) => deviceKind(d) === kind) : inRoom;
+    return pool.find(test) ?? null;
+  }
+
+  /** L'appareil d'une rangée : par identifiant, par nom, ou par pièce. */
+  function resolve(def) {
+    if (def.id) return byId(def.id);
+    if (def.match) {
+      const re = new RegExp(def.match, 'i');
+      const hit = devices.filter((d) => re.test(nameOf(d.id)) && (!def.kind || deviceKind(d) === def.kind));
+      // Une pièce Hue entière avant ses lampes : on commande le groupe.
+      return (def.group ? hit.find((d) => (d.members ?? []).length > 1) : null) ?? hit[0] ?? null;
+    }
+    if (!def.room) return null;
+    return pick(def.room, () => true, def.kind ?? null);
+  }
+
+  /** Le capteur d'une pièce : température, et humidité quand il la sait. */
+  function sensorOf(room) {
+    if (!room) return null;
+    return pick(
+      room,
+      (d) => {
+        const keys = d.points.map((p) => p.key);
+        return keys.includes('temperature') && !tempIgnored(room).has(d.id);
+      },
+      'sensor',
+    );
+  }
+
+  const readings = (sensor, extra = null) => {
+    if (!sensor) return extra == null ? [] : [{ icon: 'flash', text: `${Math.round(Math.abs(extra))} W`, tone: 'cool' }];
+    const list = [];
+    const temp = value(sensor.id, 'temperature') ?? value(sensor.id, 'temp_current');
+    const hum = value(sensor.id, 'humidity') ?? value(sensor.id, 'humidity_value');
+    if (typeof temp === 'number') list.push({ icon: 'thermometer', text: `${temp.toFixed(1)}°` });
+    if (typeof hum === 'number') list.push({ icon: 'humidity', text: `${Math.round(hum)} %` });
+    if (extra != null && Number.isFinite(Number(extra))) list.push({ icon: 'flash', text: `${Math.round(Math.abs(Number(extra)))} W`, tone: 'cool' });
+    return list;
+  };
+
+  /** La vitesse du ventilateur d'une rangée, quand il en a une. */
+  function fanOf(d) {
+    if (!d) return null;
+    const fan = [d.id, ...(d.members ?? [])].map((m) => device(m)).find((x) => x?.points.some((p) => p.key === 'fan_speed'));
+    const v = fan ? value(fan.id, 'fan_speed') : null;
+    return typeof v === 'number' ? { icon: 'fan', text: `${v} %` } : null;
+  }
+
+  // Une rangée prête à rendre : l'appareil résolu, son nom, ses pastilles.
+  // Une entrée introuvable (appareil absent, pièce vide) est sautée : pas
+  // de rangée fantôme.
+  const rows = $derived.by(() =>
+    (home.config?.tablette?.rows ?? []).flatMap((def) => {
+      const d = resolve(def);
+      if (!d) return [];
+      const extra = def.power ? value(home.config?.badges?.linky ?? 'linky:linky', def.power) : null;
+      const fan = fanOf(d);
+      const label = def.nkey ? t(def.nkey) : (def.name ?? nameOf(d.id));
+      return [
+        {
+          key: def.id ?? def.match ?? def.room ?? label,
+          id: d.id,
+          label,
+          icon: def.icon ?? 'light',
+          level: def.level ?? null,
+          toggles: def.toggles !== false,
+          pair: def.pair === true,
+          subs: [...(fan ? [fan] : []), ...readings(sensorOf(def.sensor_room ?? def.room), extra)],
+        },
+      ];
+    }),
+  );
+
+  // Les rangées consécutives marquées `pair` forment un groupe côte à côte.
+  const groups = $derived.by(() => {
+    const out = [];
+    for (const r of rows) {
+      const last = out.at(-1);
+      if (r.pair && last?.pair) last.items.push(r);
+      else out.push({ pair: r.pair, items: [r] });
+    }
+    return out;
+  });
+</script>
+
+<div class="rows" aria-label={t('maison.accueil.tablette_lignes')} role="group">
+  {#each groups as g, i (i)}
+    {#if g.pair}
+      <div class="pair">
+        {#each g.items as r (r.key)}
+          <TabletteRow id={r.id} name={r.label} icon={r.icon} level={r.level} toggles={r.toggles} subs={r.subs} />
+        {/each}
+      </div>
+    {:else}
+      {#each g.items as r (r.key)}
+        <TabletteRow id={r.id} name={r.label} icon={r.icon} level={r.level} toggles={r.toggles} subs={r.subs} />
+      {/each}
+    {/if}
+  {/each}
+</div>
+
+<style>
+  .rows {
+    display: grid;
+    gap: 8px;
+  }
+
+  .pair {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 12px;
+  }
+
+  @media (max-width: 760px) {
+    .pair {
+      grid-template-columns: 1fr;
+    }
+  }
+</style>
