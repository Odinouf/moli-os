+/// The /24 to sweep for the devices still without an address: the one the
+/// known devices are on, else the one this host is on (a home network,
+/// found without configuration by asking the routing table which address
+/// would reach the outside).
+fn home_network(known: &HashSet<Ipv4Addr>, host: Option<Ipv4Addr>) -> Option<Ipv4Addr> {
+    if let Some(first) = known.iter().min() {
+        return Some(*first);
+    }
+    // No address in the device file: use the home network this host sits
+    // on. The choice itself is pure (tested); the probe stays in host_ipv4.
+    host
+}
+
+/// The address this host would use to reach the outside, asked of the
+/// routing table (no packet leaves). `None` when there is no IPv4 route —
+/// the caller then sweeps nothing rather than guessing.
+fn host_ipv4() -> Option<Ipv4Addr> {
+    let probe = std::net::UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0)).ok()?;
+    // No packet leaves: this only asks the kernel which source it would use.
+    probe.connect((Ipv4Addr::new(8, 8, 8, 8), 80)).ok()?;
+    match probe.local_addr().ok()?.ip() {
+        std::net::IpAddr::V4(ip) => Some(ip),
+        std::net::IpAddr::V6(_) => None,
+    }
+}
